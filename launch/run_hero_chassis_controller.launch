<launch>

    <!-- 启动老师的机器人模型和 Gazebo -->
    <include file="$(find rm_description_for_task)/launch/hero.launch">
        <arg name="load_chassis" value="true"/>
        <arg name="roller_type" value="realistic"/>
        <arg name="paused" value="true"/>
    </include>

    <!-- 加载自己的控制器参数 -->
    <rosparam
        file="$(find hero_chassis_controller)/config/controllers.yaml"
        command="load"/>

    <!-- 启动自己的控制器 -->
    <node
        name="controller_spawner"
        pkg="controller_manager"
        type="spawner"
        respawn="false"
        output="screen"
        args="
            controller/hero_chassis_controller
            controller/joint_state_controller
        "/>

</launch>
